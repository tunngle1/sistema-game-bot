# Локальный тест: скопируйте в .env.local и запустите `vercel dev` из папки bot/
# На Vercel: Settings → Environment Variables (не коммитьте реальные значения!)

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# GetPlatinum API (Настройки → Организации → шестерёнка → API-ключ)
GETPLATINUM_ACCOUNT=shkarov-dmitrii
GETPLATINUM_API_KEY=your_getplatinum_api_key_here

# Публичный URL бота на Vercel (для notificationUrl webhook)
BOT_PUBLIC_URL=https://sistema-game-bot.vercel.app

# Куда вернуть пользователя после оплаты (опционально)
PAYMENT_SUCCESS_URL=https://sistema-game-vert.vercel.app/
PAYMENT_FAIL_URL=https://sistema-game-vert.vercel.app/
